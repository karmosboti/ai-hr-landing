---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Probléma",
    path: "#problema",
  },
  {
    title: "Megoldás",
    path: "#megoldas",
  },
  {
    title: "Hogyan működik",
    path: "#hogyan-mukodik",
  },
  {
    title: "Árak",
    path: "#arak",
  },
  {
    title: "GYIK",
    path: "#gyik",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg flex items-center gap-2">
          <span class="bg-green-600 text-white px-2 py-1 rounded font-bold text-sm">AI</span>
          <span class="font-bold text-slate-800">HR Agent</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                  <span>{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link 
            href="#konzultacio" 
            size="md" 
            block
            class="!bg-green-600 hover:!bg-green-700 !border-green-600">
            Konzultáció
          </Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <Link 
          href="#konzultacio" 
          size="md"
          class="!bg-green-600 hover:!bg-green-700 !border-green-600">
          Ingyenes Konzultáció
        </Link>
      </div>
    </div>
  </header>
</Container>
