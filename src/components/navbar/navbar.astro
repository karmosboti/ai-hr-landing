---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  { title: "A gond", path: "#gond" },
  { title: "Mit csinál", path: "#mit-csinal" },
  { title: "Árak", path: "#arak" },
  { title: "Kérdések", path: "#kerdesek" },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center py-6">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-[var(--color-brand-600)] rounded-lg flex items-center justify-center transition-transform group-hover:rotate-3">
            <span class="text-white font-bold text-lg font-[var(--font-display)]">hr</span>
          </div>
          <span class="font-semibold text-[var(--color-ink-900)] text-lg">AI HR Agent</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-6 h-6 text-[var(--color-ink-700)]" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-1">
          {menuitems.map((item) => (
            <li>
              <a
                href={item.path}
                class="flex lg:px-4 py-2 items-center text-[var(--color-ink-600)] hover:text-[var(--color-ink-900)] font-medium transition-colors">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
        <div class="lg:hidden flex items-center mt-4">
          <a href="#beszeljunk" class="btn-primary w-full justify-center">
            Beszéljünk
          </a>
        </div>
      </MenuItems>
    </Astronav>
    <div class="hidden lg:block">
      <a href="#beszeljunk" class="btn-primary">
        Beszéljünk
      </a>
    </div>
  </header>
</Container>
