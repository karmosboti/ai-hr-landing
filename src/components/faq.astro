---
const faqs = [
  {
    question: "Cserélhető lesz az emberi HR-es?",
    answer: "Nem. Az AI a repetitív részeket veszi le a válladról (CV szűrés, időpont egyeztetés). A döntést (kit veszünk fel) továbbra is te hozod meg."
  },
  {
    question: "GDPR-kompatibilis?",
    answer: "Igen. Az AI agent az általad jóváhagyott szabályok szerint kezeli az adatokat. Minden jelölt hozzájárul az adatkezeléshez."
  },
  {
    question: "Mi van, ha nem tetszik?",
    answer: "Az első hónapban bármikor kiléphetsz, visszaadjuk a setup díj 50%-át."
  },
  {
    question: "Milyen ATS rendszerekkel működik?",
    answer: "Google Sheets, Notion, Airtable, vagy email alapú folyamat. Ha van meglévő ATS-ed, integráljuk (PRO csomag)."
  },
  {
    question: "Mennyi idő alatt indul?",
    answer: "1 hét setup → utána azonnal használható."
  }
];
---

<section class="py-16 md:py-24 bg-slate-50" id="gyik">
  <div class="max-w-3xl mx-auto px-5">
    <div class="text-center mb-12">
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
        Gyakori kérdések
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="text-lg font-semibold text-slate-800 flex items-center gap-3">
              <span class="text-green-600">❓</span>
              {faq.question}
            </span>
            <span class="text-2xl text-slate-400 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-slate-600 border-t border-slate-100">
            <p class="pt-4">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
