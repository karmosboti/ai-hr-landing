---
import Container from "@/components/container.astro";
---

<footer class="border-t border-[var(--color-ink-200)] mt-0 bg-white">
  <Container>
    <div class="py-12 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[var(--color-brand-600)] rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-lg font-[var(--font-display)]">hr</span>
        </div>
        <span class="font-semibold text-[var(--color-ink-900)]">AI HR Agent</span>
      </div>
      
      <div class="text-[var(--color-ink-500)] text-sm text-center md:text-right">
        <p>© {new Date().getFullYear()} AI HR Agent</p>
      </div>
    </div>
  </Container>
</footer>
