---
import Container from "@/components/container.astro";
---

<footer class="border-t border-slate-200 mt-20">
  <Container>
    <div class="py-10 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <span class="bg-green-600 text-white px-2 py-1 rounded font-bold text-sm">AI</span>
        <span class="font-bold text-slate-800">HR Agent</span>
      </div>
      <div class="text-slate-500 text-sm text-center md:text-right">
        <p>© {new Date().getFullYear()} AI HR Agent. Minden jog fenntartva.</p>
        <p class="mt-1">KKV-knak AI-alapú HR munkatárs 24/7</p>
      </div>
    </div>
  </Container>
</footer>
