---
import { Icon } from "astro-icon/components";

const steps = [
  {
    number: "1",
    emoji: "1️⃣",
    title: "Brief + Beállítás",
    duration: "1 hét",
    points: [
      "Konzultáció: milyen pozícióra toborozol, mik a követelmények",
      "Mi felépítjük az AI agentedet, integrálunk minden szükséges rendszerbe",
      "Tesztelés: próbajelöltekkel finom-hangoljuk"
    ]
  },
  {
    number: "2",
    emoji: "2️⃣",
    title: "Az agent munkába áll",
    duration: "",
    points: [
      "Jelöltek jelentkeznek (email/webform/LinkedIn)",
      "Az AI kezeli: szűrés, visszajelzés, előszűrő, időpont foglalás",
      "Te kapod a shortlistet és az összefoglalókat"
    ]
  },
  {
    number: "3",
    emoji: "3️⃣",
    title: "Te csak az interjúzással foglalkozol",
    duration: "",
    points: [
      "Hetente 1x megnézed a TOP jelölteket",
      "Interjúzol (vagy nem)",
      "Döntesz"
    ]
  }
];
---

<section class="py-16 md:py-24 bg-slate-50" id="hogyan-mukodik">
  <div class="max-w-5xl mx-auto px-5">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
        Hogyan működik?
      </h2>
      <p class="text-lg mt-4 text-slate-600">
        3 egyszerű lépés
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((step, index) => (
        <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 items-start">
          <div class="bg-green-600 text-white text-3xl font-bold rounded-full w-16 h-16 flex items-center justify-center shrink-0">
            {step.number}
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <h3 class="text-2xl font-bold text-slate-800">{step.title}</h3>
              {step.duration && (
                <span class="bg-green-100 text-green-700 text-sm px-3 py-1 rounded-full font-medium">
                  {step.duration}
                </span>
              )}
            </div>
            <ul class="space-y-2">
              {step.points.map((point) => (
                <li class="text-slate-600 flex items-start gap-2">
                  <span class="text-green-500 mt-1">→</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <div class="inline-block bg-green-100 text-green-800 px-6 py-4 rounded-xl">
        <p class="text-xl font-bold">
          ⏱️ Időmegtakarítás: <span class="text-green-600">10-15 óra/hét → 1-2 óra/hét</span>
        </p>
      </div>
    </div>
  </div>
</section>
