---
---

<section class="py-20 md:py-28 bg-white" id="hogyan">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="section-label mb-4">A folyamat</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl text-[var(--color-ink-950)]">
        Egy hét, és megy
      </h2>
    </div>
    
    <div class="relative">
      <!-- Connection line (desktop) -->
      <div class="hidden lg:block absolute top-24 left-[16.67%] right-[16.67%] h-0.5 bg-[var(--color-ink-200)]"></div>
      
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Step 1 -->
        <div class="relative">
          <div class="lg:text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--color-brand-600)] text-white flex items-center justify-center text-xl font-semibold mb-6 lg:mx-auto relative z-10">
              1
            </div>
            <h3 class="text-xl font-semibold text-[var(--color-ink-900)] mb-3">Beszélgetünk</h3>
            <p class="text-[var(--color-ink-600)]">
              Fél óra. Elmondod, milyen pozícióra keresel embert, 
              mik a követelmények, milyen rendszereket használsz.
            </p>
          </div>
        </div>
        
        <!-- Step 2 -->
        <div class="relative">
          <div class="lg:text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--color-brand-600)] text-white flex items-center justify-center text-xl font-semibold mb-6 lg:mx-auto relative z-10">
              2
            </div>
            <h3 class="text-xl font-semibold text-[var(--color-ink-900)] mb-3">Mi felépítjük</h3>
            <p class="text-[var(--color-ink-600)]">
              Kb. 5 munkanap. Bekötjük az emailedet, a naptáradat, 
              beállítjuk a szűrési kritériumokat. Teszteljük.
            </p>
          </div>
        </div>
        
        <!-- Step 3 -->
        <div class="relative">
          <div class="lg:text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--color-brand-600)] text-white flex items-center justify-center text-xl font-semibold mb-6 lg:mx-auto relative z-10">
              3
            </div>
            <h3 class="text-xl font-semibold text-[var(--color-ink-900)] mb-3">Megy magától</h3>
            <p class="text-[var(--color-ink-600)]">
              Jönnek a jelentkezők, az agent dolgozik. 
              Te heti egyszer átnézed a shortlistet, döntesz.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
