---
---

<section class="py-20 md:py-28" id="beszeljunk">
  <div class="max-w-4xl mx-auto px-5">
    <div class="bg-[var(--color-ink-950)] p-8 md:p-12 lg:p-16 rounded-3xl relative overflow-hidden">
      <!-- Decorative elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--color-brand-600)] opacity-10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-[var(--color-brand-500)] opacity-10 rounded-full blur-3xl"></div>
      
      <div class="relative z-10 max-w-2xl">
        <div class="accent-bar mb-8 !bg-[var(--color-brand-500)]"></div>
        
        <h2 class="text-3xl md:text-4xl lg:text-5xl text-white leading-tight">
          Beszéljünk fél órát
        </h2>
        
        <p class="mt-6 text-lg md:text-xl text-[var(--color-ink-400)] leading-relaxed">
          Megnézzük, mennyit takarítanál meg, megmutatjuk az agentet működés közben. 
          Ha nem érdekel utána, semmi gond.
        </p>
        
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="https://calendly.com" target="_blank" rel="noopener" 
             class="btn-primary !bg-[var(--color-brand-500)] hover:!bg-[var(--color-brand-600)]">
            Foglalok időpontot
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
        
        <p class="mt-6 text-sm text-[var(--color-ink-500)]">
          30 perc, online, nem kötelez semmire.
        </p>
      </div>
    </div>
  </div>
</section>
