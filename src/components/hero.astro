---
---

<main class="pt-12 pb-20 md:pt-20 md:pb-32">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <!-- Left column: Main content -->
      <div class="lg:col-span-7">
        <div class="accent-bar mb-8"></div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-[var(--color-ink-950)]">
          Heti 15 óra CV-olvasás helyett<br/>
          <span class="text-[var(--color-brand-600)]">1 óra döntéshozatal</span>
        </h1>
        
        <p class="mt-8 text-lg md:text-xl text-[var(--color-ink-600)] max-w-xl leading-relaxed">
          Az AI HR agent elvégzi a toborzás unalmas részét. CV szűrés, email 
          ping-pong, interjú időpontok. Te csak azzal foglalkozol, amihez ember kell: 
          eldönteni, ki passzol a csapatba.
        </p>
        
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="#beszeljunk" class="btn-primary">
            Beszéljünk 30 percet
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#mit-csinal" class="btn-secondary">
            Megnézem, mit csinál
          </a>
        </div>
      </div>
      
      <!-- Right column: Stats/proof -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-[var(--color-ink-100)]">
          <p class="section-label mb-6">Számok, nem ígéretek</p>
          
          <div class="space-y-6">
            <div class="pb-6 border-b border-[var(--color-ink-100)]">
              <p class="text-4xl md:text-5xl font-[var(--font-display)] text-[var(--color-ink-950)]">10-15</p>
              <p class="text-[var(--color-ink-500)] mt-1">óra/hét toborzással (most)</p>
            </div>
            
            <div class="pb-6 border-b border-[var(--color-ink-100)]">
              <p class="text-4xl md:text-5xl font-[var(--font-display)] text-[var(--color-brand-600)]">1-2</p>
              <p class="text-[var(--color-ink-500)] mt-1">óra/hét toborzással (utána)</p>
            </div>
            
            <div>
              <p class="text-4xl md:text-5xl font-[var(--font-display)] text-[var(--color-ink-950)]">24h</p>
              <p class="text-[var(--color-ink-500)] mt-1">válaszidő minden jelöltnek</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
